# ==============================================================================
# PhishGuard V2 - Environment Configuration
# Copy this file to .env and provide your optional API keys.
# All external threat intelligence providers are optional.
# If keys are omitted, PhishGuard runs with local ML and offline heuristic signatures.
# ==============================================================================

# Google Safe Browsing Lookup API (v4)
# Get a key from Google Cloud Console: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# PhishTank API Key (Optional; PhishTank allows limited checks without key, or full API with key)
# Register at: https://phishtank.org/developer_info.php
PHISHTANK_API_KEY=

# OpenPhish Feed / API Key (Optional)
# Details at: https://openphish.com/
OPENPHISH_API_KEY=

# Domain and Certificate Signals
# Enables safe DNS resolution and TLS certificate header inspection (SNI handshake only, zero HTTP fetching)
ENABLE_DOMAIN_SIGNALS=true
DOMAIN_SIGNALS_TIMEOUT=3.0

# Threat Intelligence Cache and Timeouts
THREAT_INTEL_CACHE_TTL=3600
THREAT_INTEL_TIMEOUT=3.0

# Privacy-Preserving Local Scan History
ENABLE_SCAN_HISTORY=true
SCAN_HISTORY_MAX=50

# Flask Application Settings
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=phishguard-v2-dev-secret-change-in-production
